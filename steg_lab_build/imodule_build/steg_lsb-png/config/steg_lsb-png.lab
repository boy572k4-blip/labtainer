LABNAME steg_lsb-png
FROM labtainer.base

NETWORK MNET 172.21.0.0/24 MASK 24

CONTAINER sender
    TERMINALS 1
    DOCKER_REGISTRY r3xonx
    IMAGE steg_lsb-png.sender
    REUSE_CONTAINER NO
    ADD_HOST receiver:172.21.0.30
END_CONTAINER

CONTAINER receiver
    TERMINALS 1
    DOCKER_REGISTRY r3xonx
    IMAGE steg_lsb-png.receiver
    REUSE_CONTAINER NO
    ADD_HOST sender:172.21.0.20
END_CONTAINER
